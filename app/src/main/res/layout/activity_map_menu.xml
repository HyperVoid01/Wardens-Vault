<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_brick_wall"
    android:orientation="vertical"
    tools:context=".MapMenuActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/rowCastle"
                style="@style/MenuRow">

                <ImageView
                    style="@style/MenuRowIcon"
                    android:contentDescription="Castle"
                    android:src="@drawable/ic_menu_castle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MenuRowLabel"
                        android:text="Castle"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHint"
                        style="@style/MenuRowLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Budgets &amp; Goals"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowMarket"
                style="@style/MenuRow">

                <ImageView
                    style="@style/MenuRowIcon"
                    android:contentDescription="Market"
                    android:src="@drawable/ic_menu_market" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MenuRowLabel"
                        android:text="Market"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHint4"
                        style="@style/MenuRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expenses"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowArmory"
                style="@style/MenuRow">

                <ImageView
                    style="@style/MenuRowIcon"
                    android:contentDescription="Armory"
                    android:src="@drawable/ic_menu_armory" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MenuRowLabel"
                        android:text="Armory"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHint6"
                        style="@style/MenuRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Customisation"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowDungeon"
                style="@style/MenuRow">
                <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_menu_dungeon" android:contentDescription="Dungeon" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MenuRowLabel"
                        android:text="Dungeon"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHint2"
                        style="@style/MenuRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bills"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTreasury"
                style="@style/MenuRow">
                <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_menu_treasury" android:contentDescription="Treasury" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MenuRowLabel"
                        android:text="Treasury"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHint3"
                        style="@style/MenuRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Income &amp; Net Worth"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowReports"
                style="@style/MenuRow">
                <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_menu_reports" android:contentDescription="Reports" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MenuRowLabel"
                        android:text="Reports"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHint5"
                        style="@style/MenuRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Analytics"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowProfile"
                style="@style/MenuRow">
                <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_menu_profile" android:contentDescription="Profile" />

                <TextView
                    style="@style/MenuRowLabel"
                    android:text="Profile"
                    android:textSize="24sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D95763"
        app:itemIconTint="@null"
        app:itemIconSize="40dp"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
