<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".CreateExpenseActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/ScreenTitle"
                android:text="New Expense" />

            <TextView
                style="@style/FieldLabel"
                android:text="Category" />

            <Spinner
                android:id="@+id/spCategory"
                style="@style/FieldInput"
                android:background="@drawable/bg_input_light" />

            <TextView
                style="@style/FieldLabel"
                android:text="Amount spent (R)" />

            <EditText
                android:id="@+id/etAmount"
                style="@style/FieldInput"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/btnCalculator"
                style="@style/ActionButton"
                android:layout_width="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Open Calculator" />

            <TextView
                style="@style/FieldLabel"
                android:text="Description (optional)" />

            <EditText
                android:id="@+id/etDescription"
                style="@style/FieldInput"
                android:inputType="textCapSentences" />

            <CheckBox
                android:id="@+id/cbRecurring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:buttonTint="#FFC107"
                android:text="This is a recurring expense"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Only shown for recurring expenses -->
            <LinearLayout
                android:id="@+id/llFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FieldLabel"
                    android:text="How often it repeats" />

                <Spinner
                    android:id="@+id/spFrequency"
                    style="@style/FieldInput"
                    android:background="@drawable/bg_input_light" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDateLabel"
                style="@style/FieldLabel"
                android:text="Date" />

            <Button
                android:id="@+id/btnPickDate"
                style="@style/PickerButton"
                tools:text="26 Oct 2026" />

            <!-- One-off expense: optional start and end time -->
            <LinearLayout
                android:id="@+id/llTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:text="Start time (optional)" />

                <Button
                    android:id="@+id/btnPickStartTime"
                    style="@style/PickerButton"
                    android:text="No time - tap to pick one" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="End time (optional)" />

                <Button
                    android:id="@+id/btnPickEndTime"
                    style="@style/PickerButton"
                    android:text="No time - tap to pick one" />

                <Button
                    android:id="@+id/btnClearTimes"
                    style="@style/ActionButton"
                    android:layout_width="wrap_content"
                    android:text="Clear times"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Recurring expense: start date (above) and end date -->
            <LinearLayout
                android:id="@+id/llEndDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FieldLabel"
                    android:text="End date (optional)" />

                <Button
                    android:id="@+id/btnPickEndDate"
                    style="@style/PickerButton"
                    android:text="No end date - tap to pick one" />

                <TextView
                    style="@style/FieldNote"
                    android:text="Leave the end date empty if it keeps repeating." />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:text="Receipt photo (optional)" />

            <Button
                android:id="@+id/btnTakePhoto"
                style="@style/ActionButton"
                android:text="Take Photo" />

            <Button
                android:id="@+id/btnPickPhoto"
                style="@style/ActionButton"
                android:text="Choose From Gallery" />

            <ImageView
                android:id="@+id/ivPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="#1A237E"
                android:contentDescription="Receipt preview"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRemovePhoto"
                style="@style/ActionButton"
                android:text="Remove Receipt"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSaveExpense"
                style="@style/ActionButton"
                android:layout_marginTop="24dp"
                android:text="Save Expense" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        style="@style/BottomNavBar"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
