<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".BudgetGoalActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/ScreenTitle"
                android:text="Monthly Budget" />

            <TextView
                style="@style/FieldLabel"
                android:text="Minimum monthly spending goal (R)" />

            <EditText
                android:id="@+id/etMinGoal"
                style="@style/FieldInput"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/FieldLabel"
                android:text="Maximum monthly spending goal (R)" />

            <EditText
                android:id="@+id/etMaxGoal"
                style="@style/FieldInput"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/FieldNote"
                android:text="The maximum is your monthly budget. Spending between the two goals counts as on track." />

            <Button
                android:id="@+id/btnSaveGoal"
                style="@style/ActionButton"
                android:layout_marginTop="16dp"
                android:text="Save Goal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month So Far"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpentThisMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFC107"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Spent: R340.00" />

                <TextView
                    android:id="@+id/tvGoalStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFFFFF"
                    tools:text="Within your goal range" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        style="@style/BottomNavBar"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
